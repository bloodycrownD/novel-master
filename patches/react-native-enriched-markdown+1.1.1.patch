+package com.swmansion.enriched.markdown
+
+import com.swmansion.enriched.markdown.input.formatting.RangeEditAdjustment
+import com.swmansion.enriched.markdown.input.model.FormattingRange
+import com.swmansion.enriched.markdown.input.model.MutableRangeBounds
+import com.swmansion.enriched.markdown.input.model.StyleType
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertSame
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * KT-CA1（D2 分支表逐行矩阵，本仓 fork）：protected 区间 = TOKEN 胶囊，
+ * 边界冻结——删除/替换任意相交 → 整条摘除；纯插入严格内部 → 整条摘除；
+ * 左端点及左侧插入 → 整体右移；右端点及右侧插入 → 原样不动。
+ */
+class RangeEditAdjustmentTest {
+  /** 纯区间载体，避免测试依赖 FormattingRange 的样式语义。 */
+  private class Bounds(
+    override var start: Int,
+    override var end: Int,
+  ) : MutableRangeBounds
+
+  private fun adjustProtected(
+    ranges: MutableList<Bounds>,
+    editLocation: Int,
+    deletedLength: Int,
+    insertedLength: Int,
+  ) {
+    RangeEditAdjustment.adjustForEdit(
+      ranges,
+      editLocation,
+      deletedLength,
+      insertedLength,
+      isProtected = { true },
+    )
+  }
+
+  private fun bounds(vararg pairs: Pair<Int, Int>): MutableList<Bounds> =
+    pairs.map { Bounds(it.first, it.second) }.toMutableList()
+
+  // ---- 纯插入分支 ----
+
+  @Test
+  fun insertBeforeRangeShiftsRight() {
+    val ranges = bounds(5 to 10)
+    adjustProtected(ranges, editLocation = 2, deletedLength = 0, insertedLength = 3)
+    assertEquals(1, ranges.size)
+    assertEquals(8, ranges[0].start)
+    assertEquals(13, ranges[0].end)
+  }
+
+  @Test
+  fun insertAtRangeStartShiftsRightAndNeverGrows() {
+    val ranges = bounds(5 to 10)
+    // growsAtStartOnInsert 对 TOKEN 固定 false：protected 分支压根不看它。
+    RangeEditAdjustment.adjustForEdit(
+      ranges,
+      editLocation = 5,
+      deletedLength = 0,
+      insertedLength = 2,
+      growsAtStartOnInsert = { true },
+      isProtected = { true },
+    )
+    assertEquals(1, ranges.size)
+    assertEquals(7, ranges[0].start)
+    assertEquals(12, ranges[0].end)
+  }
+
+  @Test
+  fun insertAtRangeEndKeepsRangeUnchanged() {
+    val ranges = bounds(5 to 10)
+    adjustProtected(ranges, editLocation = 10, deletedLength = 0, insertedLength = 4)
+    assertEquals(1, ranges.size)
+    assertEquals(5, ranges[0].start)
+    // 右边界不吞尾追：插入点在端点处，区间不增长。
+    assertEquals(10, ranges[0].end)
+  }
+
+  @Test
+  fun insertAfterRangeEndKeepsRangeUnchanged() {
+    val ranges = bounds(5 to 10)
+    adjustProtected(ranges, editLocation = 12, deletedLength = 0, insertedLength = 3)
+    assertEquals(1, ranges.size)
+    assertEquals(5, ranges[0].start)
+    assertEquals(10, ranges[0].end)
+  }
+
+  @Test
+  fun insertStrictlyInsideRangeRemovesIt() {
+    val ranges = bounds(5 to 10)
+    adjustProtected(ranges, editLocation = 7, deletedLength = 0, insertedLength = 1)
+    assertTrue("胶囊内部插入 → 整条摘除", ranges.isEmpty())
+  }
+
+  // ---- 删除/替换分支 ----
+
+  @Test
+  fun deleteFullyCoveringRangeRemovesIt() {
+    val ranges = bounds(5 to 10)
+    adjustProtected(ranges, editLocation = 3, deletedLength = 10, insertedLength = 0)
+    assertTrue(ranges.isEmpty())
+  }
+
+  @Test
+  fun deleteOverlappingStartRemovesWholeRange() {
+    val ranges = bounds(5 to 10)
+    adjustProtected(ranges, editLocation = 3, deletedLength = 4, insertedLength = 0)
+    assertTrue("部分覆盖起点也整删，不留半截", ranges.isEmpty())
+  }
+
+  @Test
+  fun deleteOverlappingEndRemovesWholeRange() {
+    val ranges = bounds(5 to 10)
+    adjustProtected(ranges, editLocation = 8, deletedLength = 4, insertedLength = 0)
+    assertTrue("部分覆盖终点也整删，不留半截", ranges.isEmpty())
+  }
+
+  @Test
+  fun deleteStrictlyInsideRangeRemovesIt() {
+    val ranges = bounds(5 to 10)
+    adjustProtected(ranges, editLocation = 7, deletedLength = 1, insertedLength = 0)
+    assertTrue("内部删除 → 整条摘除（禁止区间缩尾留下半截）", ranges.isEmpty())
+  }
+
+  @Test
+  fun deleteEntirelyBeforeRangeShiftsLeft() {
+    val ranges = bounds(5 to 10)
+    adjustProtected(ranges, editLocation = 0, deletedLength = 2, insertedLength = 0)
+    assertEquals(1, ranges.size)
+    assertEquals(3, ranges[0].start)
+    assertEquals(8, ranges[0].end)
+  }
+
+  @Test
+  fun deleteEndingAtRangeStartShiftsLeft() {
+    val ranges = bounds(5 to 10)
+    adjustProtected(ranges, editLocation = 2, deletedLength = 3, insertedLength = 0)
+    assertEquals(1, ranges.size)
+    assertEquals(2, ranges[0].start)
+    assertEquals(7, ranges[0].end)
+  }
+
+  @Test
+  fun deleteStartingAtRangeEndKeepsRange() {
+    val ranges = bounds(5 to 10)
+    adjustProtected(ranges, editLocation = 10, deletedLength = 2, insertedLength = 0)
+    assertEquals(1, ranges.size)
+    assertEquals(5, ranges[0].start)
+    assertEquals(10, ranges[0].end)
+  }
+
+  @Test
+  fun replacementIntersectingStartDoesNotInherit() {
+    val ranges = bounds(5 to 10)
+    RangeEditAdjustment.adjustForEdit(
+      ranges,
+      editLocation = 5,
+      deletedLength = 2,
+      insertedLength = 3,
+      inheritsReplacementAtStart = { true },
+      isProtected = { true },
+    )
+    assertTrue("替换不继承 TOKEN，整条摘除", ranges.isEmpty())
+  }
+
+  @Test
+  fun replacementEntirelyBeforeRangeShifts() {
+    val ranges = bounds(5 to 10)
+    adjustProtected(ranges, editLocation = 1, deletedLength = 2, insertedLength = 4)
+    assertEquals(1, ranges.size)
+    assertEquals(7, ranges[0].start)
+    assertEquals(12, ranges[0].end)
+  }
+
+  // ---- 多胶囊并集 / 零长度 / 混合类型 ----
+
+  @Test
+  fun deleteSpanningTwoCapsulesRemovesBoth() {
+    val ranges = bounds(5 to 8, 12 to 15)
+    adjustProtected(ranges, editLocation = 4, deletedLength = 9, insertedLength = 0)
+    assertTrue("删除窗跨两颗胶囊 → 各自整删", ranges.isEmpty())
+  }
+
+  @Test
+  fun deleteBetweenTwoCapsulesKeepsBothAndShiftsRightOne() {
+    val ranges = bounds(0 to 3, 4 to 7)
+    adjustProtected(ranges, editLocation = 3, deletedLength = 1, insertedLength = 0)
+    assertEquals(2, ranges.size)
+    assertEquals(0, ranges[0].start)
+    assertEquals(3, ranges[0].end)
+    assertEquals(3, ranges[1].start)
+    assertEquals(6, ranges[1].end)
+  }
+
+  @Test
+  fun zeroLengthRangeIsPruned() {
+    val ranges = bounds(5 to 5)
+    adjustProtected(ranges, editLocation = 0, deletedLength = 1, insertedLength = 0)
+    assertTrue("零长度区间一律剔除", ranges.isEmpty())
+  }
+
+  @Test
+  fun mixedRangesOnlyTokenIsProtected() {
+    val bold = FormattingRange(StyleType.BOLD, 5, 10)
+    val token = FormattingRange(StyleType.TOKEN, 5, 10)
+    val ranges = mutableListOf<FormattingRange>(bold, token)
+    RangeEditAdjustment.adjustForEdit(
+      ranges,
+      editLocation = 5,
+      deletedLength = 2,
+      insertedLength = 2,
+      inheritsReplacementAtStart = { true },
+      isProtected = { it.type == StyleType.TOKEN },
+    )
+    assertEquals(1, ranges.size)
+    assertSame("BOLD 保持上游继承语义，只有 TOKEN 被摘除", bold, ranges[0])
+    // CLIPPED_START + 继承：替换文本并入，存活段 (7,10) 保留，区间仍是 (5,10)。
+    assertEquals(5, bold.start)
+    assertEquals(10, bold.end)
+  }
+
+  @Test
+  fun emptyEditLeavesRangesUntouched() {
+    val ranges = bounds(5 to 10)
+    adjustProtected(ranges, editLocation = 7, deletedLength = 0, insertedLength = 0)
+    assertEquals(1, ranges.size)
+    assertEquals(5, ranges[0].start)
+    assertEquals(10, ranges[0].end)
+  }
+}
