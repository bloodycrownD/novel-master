+package com.swmansion.enriched.markdown.spans
+
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.RectF
+import android.text.style.ReplacementSpan
+import kotlin.math.roundToInt
+
+/**
+ * 圆角背景 span，用于胶囊视觉。
+ *
+ * getSize 返回文本实测宽 + paddingHorizontal * 2，draw 画 roundRect 圆角底。
+ * 行高由 lineHeight 锁定、paddingV 视觉吸收。
+ */
+class RoundedBackgroundSpan(
+  private val backgroundColor: Int,
+  private val borderRadius: Float,
+  private val paddingHorizontal: Float,
+  private val paddingTop: Float,
+  private val paddingBottom: Float,
+) : ReplacementSpan() {
+
+  private val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+    style = Paint.Style.FILL
+    color = backgroundColor
+  }
+
+  private val rect = RectF()
+
+  override fun getSize(
+    paint: Paint,
+    text: CharSequence,
+    start: Int,
+    end: Int,
+    fm: Paint.FontMetricsInt?,
+  ): Int {
+    val textWidth = paint.measureText(text, start, end).roundToInt()
+    return (textWidth + paddingHorizontal * 2).roundToInt()
+  }
+
+  override fun draw(
+    canvas: Canvas,
+    text: CharSequence,
+    start: Int,
+    end: Int,
+    x: Float,
+    top: Int,
+    y: Int,
+    bottom: Int,
+    paint: Paint,
+  ) {
+    val textWidth = paint.measureText(text, start, end)
+    val totalWidth = textWidth + paddingHorizontal * 2
+    val totalHeight = (bottom - top).toFloat() + paddingTop + paddingBottom
+
+    val left = x - paddingHorizontal
+    val right = x + totalWidth + paddingHorizontal
+    val rectTop = top - paddingTop
+    val rectBottom = bottom + paddingBottom
+
+    rect.set(left, rectTop, right, rectBottom)
+
+    // 处理 span 首尾 padding 的 canvas translate
+    canvas.save()
+    canvas.translate(-paddingHorizontal, 0f)
+    canvas.drawRoundRect(rect, borderRadius, borderRadius, this.paint)
+    canvas.restore()
+  }
+}
