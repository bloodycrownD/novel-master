+package com.swmansion.enriched.markdown.input.layout
+
+import android.text.TextPaint
+
+/**
+ * 行距补偿增量的单一公式源（novel-master 补丁，CR-fix-03）。
+ *
+ * Yoga 测量与渲染必须套同一份「每行增量」：库的 InputMeasurementStore 原先以
+ * StaticLayout.setLineSpacing(0f, 1f) 自然行距测 content 高，而行高补偿只落
+ * 在渲染侧（View 每行 lineHeight dp）——测量每行比渲染矮一截，五行累计差出
+ * 一个行框，view 高度装不下渲染内容（真机像素取证：第五行暗像素仅
+ * 12px/66px 行框，输入框五行封顶后最后一行被裁）。
+ *
+ * 口径（RN 约定 lineHeight 入参是 dp）：换算成 px 后减去 paint 的真实字高
+ * （fontMetricsInt 的 ascent~descent），余数即每行要补的 px。调用方必须传入
+ * 与渲染路径同源的 paint（View 用自身 paint；InputMeasurementStore 冷测按
+ * props 的 fontFamily/fontWeight 构造），否则自定义字体下冷启动测量与渲染
+ * 仍会差一行。
+ *
+ * lineHeightDp <= 0 时返回 0f（自然行距、无补偿）。
+ */
+internal fun lineSpacingAddFrom(
+  paint: TextPaint,
+  lineHeightDp: Float,
+  density: Float,
+): Float {
+  if (lineHeightDp <= 0f) return 0f
+  val targetPx = lineHeightDp * density
+  val fm = paint.fontMetricsInt
+  return targetPx - (fm.descent - fm.ascent)
+}
