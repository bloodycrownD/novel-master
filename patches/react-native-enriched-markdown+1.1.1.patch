+ * 相邻不融合、替换不继承、调整后无半截、选区吸附纳入 TOKEN。
+ */
+class FormattingStoreTest {
+  private fun token(
+    start: Int,
+    end: Int,
+  ): FormattingRange = FormattingRange(StyleType.TOKEN, start, end)
+
+  private fun link(
+    start: Int,
+    end: Int,
+  ): FormattingRange = FormattingRange(StyleType.LINK, start, end, "https://example.com")
+
+  // ---- 相邻 TOKEN 不融合（addRange 无合并 + coalesce 跳过） ----
+
+  @Test
+  fun adjacentTokensDoNotMergeOnAdd() {
+    val store = FormattingStore()
+    store.addRange(token(0, 3), allowMerge = false)
+    store.addRange(token(3, 6), allowMerge = false)
+
+    assertEquals(2, store.allRanges.size)
+    assertEquals(0, store.allRanges[0].start)
+    assertEquals(3, store.allRanges[0].end)
+    assertEquals(3, store.allRanges[1].start)
+    assertEquals(6, store.allRanges[1].end)
+  }
+
+  @Test
+  fun adjacentBoldRangesStillMergeByDefault() {
+    val store = FormattingStore()
+    store.addRange(FormattingRange(StyleType.BOLD, 0, 3))
+    store.addRange(FormattingRange(StyleType.BOLD, 3, 6))
+
+    // 上游合并语义保持不变（只有 TOKEN 走无合并路径）。
+    assertEquals(1, store.allRanges.size)
+    assertEquals(0, store.allRanges[0].start)
+    assertEquals(6, store.allRanges[0].end)
+  }
+
+  @Test
+  fun coalesceSkipsTokensLeftAdjacentByEdit() {
+    val store = FormattingStore()
+    store.setRanges(listOf(token(0, 3), token(4, 7)))
+
+    // 删掉两颗胶囊之间的字符：两条 TOKEN 变成相邻，(3,6) 与 (0,3) 贴边。
+    store.adjustForEdit(3, 1, 0)
+
+    assertEquals("coalesce 必须跳过 TOKEN，两颗胶囊各自独立", 2, store.allRanges.size)
+    assertEquals(0, store.allRanges[0].start)
+    assertEquals(3, store.allRanges[0].end)
+    assertEquals(3, store.allRanges[1].start)
+    assertEquals(6, store.allRanges[1].end)
+  }
+
+  @Test
+  fun coalesceSkipsTokensShiftedAdjacentByInsert() {
+    val store = FormattingStore()
+    store.setRanges(listOf(token(0, 3), token(3, 6)))
+
+    store.adjustForEdit(0, 0, 2)
+
+    assertEquals(2, store.allRanges.size)
+    assertEquals(2, store.allRanges[0].start)
+    assertEquals(5, store.allRanges[0].end)
+    assertEquals(5, store.allRanges[1].start)
+    assertEquals(8, store.allRanges[1].end)
+  }
+
+  // ---- adjustForEdit：替换不继承 / 无半截 ----
+
+  @Test
+  fun replacementAtTokenStartDoesNotInheritToken() {
+    val store = FormattingStore()
+    store.setRanges(listOf(token(5, 10)))
+
+    store.adjustForEdit(5, 2, 2)
+
+    assertTrue("替换不继承 TOKEN，整条摘除", store.allRanges.isEmpty())
+  }
+
+  @Test
+  fun deleteInsideTokenLeavesNoHalfRange() {
+    val store = FormattingStore()
+    store.setRanges(listOf(token(5, 10)))
+
+    store.adjustForEdit(7, 1, 0)
+
+    assertTrue("内部删除整条摘除，不允许缩尾留下半截", store.allRanges.isEmpty())
+  }
+
+  @Test
+  fun deleteOverlappingTokenEndLeavesNoHalfRange() {
+    val store = FormattingStore()
+    store.setRanges(listOf(token(5, 10)))
+
+    store.adjustForEdit(8, 4, 0)
+
+    assertTrue(store.allRanges.isEmpty())
+  }
+
+  @Test
+  fun everyRangeStaysWellFormedAfterEdits() {
+    val store = FormattingStore()
+    store.setRanges(listOf(token(5, 10), FormattingRange(StyleType.BOLD, 12, 18)))
+
+    // 删除 TOKEN 前半段 + 插入：TOKEN 整删，BOLD 平移。
+    store.adjustForEdit(4, 4, 1)
+
+    assertTrue(store.allRanges.none { it.type == StyleType.TOKEN })
+    assertTrue("调整后不允许出现空/倒挂区间", store.allRanges.all { it.end > it.start })
+    val bold = store.allRanges.single { it.type == StyleType.BOLD }
+    assertEquals(9, bold.start)
+    assertEquals(15, bold.end)
+  }
+
+  // ---- selectionAdjustedForAtomicLinks 三断言（部分相交扩整 / 内部推 end / 在外 null） ----
+
+  @Test
+  fun selectionPartiallyOverlappingTokenExpandsToWholeToken() {
+    val store = FormattingStore()
+    store.setRanges(listOf(token(5, 10)))
+
+    assertEquals(Pair(4, 10), store.selectionAdjustedForAtomicLinks(4, 7))
+    assertEquals(Pair(5, 12), store.selectionAdjustedForAtomicLinks(7, 12))
+    // 选区完全落在胶囊内部 → 扩成整颗
+    assertEquals(Pair(5, 10), store.selectionAdjustedForAtomicLinks(6, 8))
+  }
+
+  @Test
+  fun caretInsideTokenMovesToTokenEnd() {
+    val store = FormattingStore()
+    store.setRanges(listOf(token(5, 10)))
+
+    assertEquals(Pair(10, 10), store.selectionAdjustedForAtomicLinks(7, 7))
+    // 起点/终点本身不算「内部」，不吸附
+    assertNull(store.selectionAdjustedForAtomicLinks(5, 5))
+    assertNull(store.selectionAdjustedForAtomicLinks(10, 10))
+  }
+
+  @Test
+  fun selectionOrCaretOutsideTokenReturnsNull() {
+    val store = FormattingStore()
+    store.setRanges(listOf(token(5, 10)))
+
+    assertNull(store.selectionAdjustedForAtomicLinks(3, 3))
+    assertNull("选区终点贴着胶囊起点不算相交", store.selectionAdjustedForAtomicLinks(3, 5))
+    assertNull("选区起点贴着胶囊终点不算相交", store.selectionAdjustedForAtomicLinks(10, 12))
+    assertNull("完整覆盖胶囊无需调整", store.selectionAdjustedForAtomicLinks(5, 10))
+  }
+
+  @Test
+  fun linkSnappingStillWorks() {
+    val store = FormattingStore()
+    store.setRanges(listOf(link(5, 10)))
+
+    assertEquals("LINK 内部光标仍然推 end（上游语义）", Pair(10, 10), store.selectionAdjustedForAtomicLinks(7, 7))
+    assertEquals(Pair(4, 10), store.selectionAdjustedForAtomicLinks(4, 7))
+    assertNull(store.selectionAdjustedForAtomicLinks(10, 12))
+  }
+
+  @Test
+  fun tokenWinsWhenOnlyTokenHasCaret() {
+    val store = FormattingStore()
+    store.setRanges(listOf(link(0, 4), token(8, 14)))
+
+    assertEquals(Pair(14, 14), store.selectionAdjustedForAtomicLinks(10, 10))
+    assertNull(store.selectionAdjustedForAtomicLinks(4, 8))
+  }
+}
