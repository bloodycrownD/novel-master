{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // base 用 NodeNext/target ES2022；RN 走 bundler 模式，
    // 这里把 module/moduleResolution 之类覆盖回去，否则 RN bundler 解析会挂。
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    // base 的 types 是 ["node"]；mobile 还要 jest 类型，这里显式列全。
    "types": ["jest", "node"],
    // base 启用了 noUnusedLocals/noUnusedParameters；mobile 历史代码有较多 unused，
    // 暂不跟进到 base 的严格度，避免一次性引入 129 个 TS6133/TS6138 债务。
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // 给误用 RN tsconfig 打开 web 文件的工具一条退路；正式类型检查以 tsconfig.webview-boot / src/web/tsconfig 为准
      "@web/*": ["src/web/*"]
    }
  },
  "include": ["src/**/*", "index.js", "__tests__/**/*"],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    // WebView boot 真源由 tsconfig.webview-boot.json 负责（@web + Preact JSX）；
    // 勿纳入 RN 工程，否则 IDE 会报找不到 @web、以及 Preact 组件「不能用作 JSX」。
    "src/web/**"
  ]
}