<?xml version="1.0" encoding="UTF-8"?>
<!--
  chat_project 表的 SQL mapper（schema 见 domain/chat；项目元数据 + 智能体配置列）。

  结构约定与 chat-message.mapper.xml 一致：
  - 语句 id 与 repo 方法同名（camelCase），生成器按 id 产出 generated TS 映射
    （src/infra/sql-template/generated/），repo 内只留引用。
  - <sql id="selectColumns"> 经 <include ref> 展开，生成物里每条语句都是完整字面量；
    同一片段也作为 base repository 的 columns 选项（findById 的结构化拼装消费）。
  - INSERT 的 ? 占位符写死，不用程序生成——列清单改动时必须同步占位符数量。
-->
<mapper namespace="chat_project">

  <sql id="selectColumns">id, name, created_at_ms, updated_at_ms</sql>

  <select id="list">
    SELECT <include ref="selectColumns"/> FROM chat_project ORDER BY created_at_ms
  </select>

  <update id="updateName">
    UPDATE chat_project SET name = #{name}, updated_at_ms = #{updatedAtMs} WHERE id = #{id}
  </update>

  <select id="getAgentConfig">
    SELECT agent_config_json FROM chat_project WHERE id = #{id}
  </select>

  <update id="updateAgentConfig">
    UPDATE chat_project
    SET agent_config_json = #{configJson}, updated_at_ms = #{updatedAtMs}
    WHERE id = #{id}
  </update>

  <!-- 4 个 ? 与 selectColumns 顺序一一对应；base repository 走原始 execute，占位符按位置绑定。 -->
  <insert id="insert">
    INSERT INTO chat_project (<include ref="selectColumns"/>)
    VALUES (?, ?, ?, ?)
  </insert>


  <!-- 全表扫描（引用扫描）：find-saved-model-references 用。 -->
  <select id="listAgentConfigs">
    SELECT id, agent_config_json
    FROM chat_project
  </select>
</mapper>
